{
  "name": "open-sketchbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dump:sketchbooks": "node scripts/dump-sketchbooks.mjs",
    "dump:artists": "node scripts/dump-artists.mjs",
    "dump:events": "node scripts/dump-events.mjs",
    "generate:og": "node scripts/generate-og.js",
    "generate:og:artists": "node scripts/generate-og-artists.js",
    "generate:og:events": "node scripts/generate-og-events.js",
    "build:og": "npm run dump:sketchbooks && npm run dump:artists && npm run dump:events && npm run generate:og && npm run generate:og:artists && npm run generate:og:events",
    "build": "npm run build:og && astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/node": "^10.0.6",
    "antd": "^5.20.0",
    "canvas": "^3.2.3",
    "framer-motion": "^12.34.3",
    "gifenc": "^1.0.3",
    "gray-matter": "^4.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.11.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/react": "^5.0.4",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "astro": "^6.2.1"
  }
}
