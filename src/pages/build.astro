---
export const prerender = true;
import { execSync } from "node:child_process";
import { createRequire } from "node:module";

const require = createRequire(import.meta.url);
const astroVersion = require("astro/package.json").version;

const buildDate = new Date().toISOString();
const gitCommit = execSync("git rev-parse HEAD").toString().trim();
const gitCommitShort = execSync("git rev-parse --short HEAD").toString().trim();
---

<html>
  <head>
    <meta charset="utf-8" />
    <title>Build info</title>
    <style>
      body { font-family: monospace; padding: 2rem; }
      table { border-collapse: collapse; }
      td { padding: 4px 16px 4px 0; }
      td:first-child { opacity: 0.5; }
    </style>
  </head>
  <body>
    <table>
      <tr><td>build date</td><td>{buildDate}</td></tr>
      <tr><td>astro</td><td>{astroVersion}</td></tr>
      <tr><td>git commit</td><td>{gitCommit}</td></tr>
    </table>
  </body>
</html>
