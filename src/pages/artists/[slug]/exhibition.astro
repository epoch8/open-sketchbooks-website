---
import InternalLayout from "@/layouts/InternalLayout.astro";
import { getCollection } from "astro:content";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";
import { SEOBase } from "@/content/template/seo/seo";

import Callout from "@/components/blocks/callout/Callout.astro";

/* ================================
   STATIC PATHS
================================ */

export async function getStaticPaths() {
  const artists = await getCollection("artists");

  return artists.map((artist) => ({
    params: { slug: artist.slug },
    props: { artist },
  }));
}

/* ================================
   DATA
================================ */

const { artist } = Astro.props;
const { Content } = await artist.render();

/* ================================
   SEO
================================ */

const pageSEO = {
  title: `${artist.data.title} — Sketchbook`,
  description: `Sketchbook by ${artist.data.title}`,
};
---

<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>

  <section class="section">
    <div class="container exhibition">

      {/* ================================
         HERO
      ================================= */}

      <section class="exhibition-hero">

        <p class="lead">
          You’re holding a sketchbook from the exhibition. This one belongs to <strong>{artist.data.title}</strong>.
        </p>

        </section>

    {/* ================================
         CTA
      ================================= */}

      <section class="exhibition-cta" id="rsvp">

        <div class="rsvp">

          <h2 class="rsvp__title">
            Want to keep this?
          </h2>

          <p class="rsvp__note">
            We’ll send you the digital version when it’s ready.
          </p>

          <div id="mlb2-39458049" class="rsvp__form ml-subscribe-form ml-subscribe-form-39458049">

            <div class="row-form">

              <form
                class="ml-block-form"
                action="https://assets.mailerlite.com/jsonp/1909692/forms/183874219513218877/subscribe"
                method="post"
              >
                <input
                  type="email"
                  name="fields[email]"
                  placeholder="your email"
                  required
                  class="rsvp__input"
                  autocomplete="email"
                />

                <input
                  type="hidden"
                  name="fields[artist]"
                  value={artist.slug}
                />

                <button type="submit" class="rsvp__button">
                  Get it
                </button>

                <input type="hidden" name="ml-submit" value="1" />
                <input type="hidden" name="anticsrf" value="true" />
              </form>

            </div>

            <div class="row-success rsvp__success">
              <h4 class="rsvp__success-title">You're in ✨</h4>
              <p class="rsvp__success-text">
                We’ll send you this artist’s sketchbooks
              </p>
            </div>

          </div>

        </div>

      </section>

    
    <section class="exhibition-cta flow">

        <p class="lead">
          If it caught your attention, meet the artist behind it.
        </p>

      </section>

      {/* ================================
         ARTIST VOICE (CALLOUT)
      ================================= */}

      <section class="exhibition-callout">

        <Callout>

          <p class="voice-label">From the artist</p>

          <div class="artist-voice flow">
            <Content />
          </div>

        </Callout>

      </section>

            <section>

        <p class="lead">
          Want to keep this? Scroll up to get the digital version.
        </p>

      </section>

    </div>
  </section>



</InternalLayout>

<style>

/* ================================
   LAYOUT
================================ */

.exhibition {
  max-width: 520px;
  margin: 0 auto;
  padding: 6px 16px 40px;
}

/* ================================
   HERO
================================ */

.exhibition-hero {
  display: flex;
  flex-direction: column;
  gap: 12px;

  font-size: 16px;
  line-height: 1.5;
}

.lead {
  font-weight: 500;
}

.transition {
  opacity: 0.7;
  margin-top: 2px;
}

/* ================================
   CALLOUT
================================ */

.exhibition-callout {
  margin-top: 22px;
}

.voice-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  opacity: 0.45;
  margin-bottom: 14px;
}

.artist-voice p {
  font-size: 15.5px;
  line-height: 1.65;
  opacity: 0.8;
  margin-bottom: 14px;
}

.artist-voice ul {
  margin-top: 12px;
  padding-left: 18px;
}

.artist-voice li {
  margin-bottom: 8px;
  opacity: 0.75;
  line-height: 1.5;
}

/* ================================
   CTA
================================ */

.exhibition-cta {
  margin-top: 34px;
}

.rsvp__title {
  font-size: 26px;
  line-height: 1.2;
  font-weight: 700;
  margin-bottom: 10px;
}

.rsvp__note {
  font-size: 15.5px;
  opacity: 0.7;
  margin-bottom: 16px;
}

/* ================================
   FORM BASE
================================ */

.ml-block-form {
  display: flex;
  align-items: center;
  gap: 8px;
}

.rsvp__input,
.rsvp__button {
  box-sizing: border-box;
  height: 56px;
  border-radius: 999px;
  font-size: 16px;
}

.rsvp__input {
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;

  padding: 0 18px;
  line-height: 56px;

  appearance: none;
  -webkit-appearance: none;
}

.rsvp__button {
  flex: 0 0 auto;
  padding: 0 22px;
  font-weight: 600;
  white-space: nowrap;
}

/* ================================
   MOBILE FIX
================================ */

@media (max-width: 800px) {

  /* 👇 убираем главный белый pill */
  .rsvp__form.ml-subscribe-form {
    background: none !important;
    border: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }
  /* ================================
     PARTIAL RESET (НЕ ломаем всё подряд)
  ================================= */

  .ml-subscribe-form,
  .ml-subscribe-form * {
    box-sizing: border-box;
  }

  /* убираем только опасные вещи */
  .ml-subscribe-form * {
    margin: 0;
    padding: 0;
  }

  /* ================================
     STRUCTURE
  ================================= */

  .ml-subscribe-form {
    display: block;
    width: 100%;
  }

  .ml-subscribe-form form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  /* ================================
     INPUT
  ================================= */

  .ml-subscribe-form input[type="email"] {
    display: block;
    width: 100%;
    height: 56px;

    padding: 0 18px;

    border-radius: 999px;
    border: 1px solid rgba(0,0,0,0.12);

    font-size: 16px;
    line-height: 1;

    background: #fff;

    appearance: none;
    -webkit-appearance: none;
  }

  /* ================================
     BUTTON
  ================================= */

  .ml-subscribe-form button {
    display: block;
    width: 100%;
    height: 56px;

    border-radius: 999px;
    border: none;

    font-size: 16px;
    font-weight: 600;

    background: #111;
    color: white;

    text-align: center;

    cursor: pointer;
  }

  /* ================================
     PLACEHOLDER
  ================================= */

  .ml-subscribe-form input::placeholder {
    color: rgba(0,0,0,0.45);
  }

  /* ================================
     SUCCESS STATE (КЛЮЧЕВОЕ)
  ================================= */

  /* по умолчанию скрыт */
  .row-success {
    display: none;
  }

  /* показываем после submit */
  #mlb2-39458049.is-success .row-success {
    display: block;
    margin-top: 12px;
  }

  /* скрываем форму после успеха */
  #mlb2-39458049.is-success .row-form {
    display: none;
  }


  /* success становится нормальным блоком */
  #mlb2-39458049.is-success .row-success {
    display: block;
    position: static !important;

    margin-top: 16px;
  }

  /* даём ему вертикальный ритм */
  .rsvp__success {
    display: block;
    width: 100%;

    margin-top: 16px;
    text-align: center;
    
  }

  .rsvp__success-title {
    display: block;
    font-size: 16px;
    font-weight: 600;

    margin-bottom: 4px;
        text-align: center;

  }

  .rsvp__success-text {
    display: block;
    font-size: 14px;
    opacity: 0.7;
        text-align: center;

  }

}

</style>

<script is:inline>
  function ml_webform_success_39458049() {
    const container = document.getElementById('mlb2-39458049');
    if (container instanceof HTMLElement) {
      container.classList.add('is-success');
    }
  }
</script>

<script
  is:inline
  src="https://groot.mailerlite.com/js/w/webforms.min.js"
></script>