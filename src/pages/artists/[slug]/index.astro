---
import InternalLayout from "@/layouts/InternalLayout.astro";
import Gallery from "@/components/blocks/gallery/Gallery.astro";
import CardGrid from "@/components/blocks/card-grid/CardGrid.astro";
import CardGridItem from "@/components/blocks/card-grid/CardGridItem.astro";
import Book from "@/components/blocks/book/book.astro";


import { getCollection } from "astro:content";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";

import { SEOBase } from "@/content/template/seo/seo";

/* ================================
   STATIC PATHS
================================ */

export async function getStaticPaths() {
  const artists = await getCollection("artists");

  return artists.map((artist) => ({
    params: { slug: artist.slug },
    props: { artist },
  }));
}

/* ================================
   DATA
================================ */

const { artist } = Astro.props;
const { Content } = await artist.render();

/* 👉 works */
const works = await getCollection("works");

const artistWorks = works.filter(
  (work) => work.data.artist === artist.slug
);

const galleryWorks = artistWorks.map((w) => ({
  title: w.data.title ?? undefined,
  image: w.data.image,
  slug: w.slug,
  alt: w.data.title ?? artist.data.title ?? "Artwork",
}));

/* 👉 sketchbooks */
const sketchbooks = await getCollection("sketchbooks");

const artistSketchbooks = sketchbooks
  .filter(
    (book) =>
      book.data.author === artist.slug &&
      book.data.published === true
  )
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

/* ================================
   ITEMS & COLLECTIONS
================================ */

const allItems = await getCollection("products");
const allCollections = await getCollection("productCollections");

/* фильтр по артисту */

const items = allItems.filter(
  (p) => p.data.artist === artist.slug
);

const collections = allCollections.filter(
  (c) => c.data.artist === artist.slug
);

/* ================================
   FEATURED
================================ */

const featuredItems = items.filter((p) =>
  p.data.featured?.includes("artist")
);

const featuredCollections = collections.filter((c) =>
  c.data.featured?.includes("artist")
);

/* ================================
   ОСТАЛЬНОЕ (без магии)
================================ */

const nonFeaturedCollections = collections.filter(
  (c) => !c.data.featured?.includes("artist")
);

const nonFeaturedItems = items.filter(
  (p) => !p.data.featured?.includes("artist")
);

/* ================================
   SEO
================================ */

const pageSEO = {
  title: artist.data.title,
  description: `Works by ${artist.data.title}`,
};
---

<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>
  <section class="section">
    <div class="container flow">

  {/* 👉 HEADER */}
  <header class="hero-header">

    <div class="hero-header__left">
      <h1>{artist.data.title}</h1>

      <div class="artist-meta">

        {artist.data.style && (
          <span class="style">
            {artist.data.style}
          </span>
        )}

        {artist.data.instagram && (
          <a
            href={`https://instagram.com/${artist.data.instagram}`}
            target="_blank"
            rel="noopener noreferrer"
            class="instagram"
          >
            @{artist.data.instagram}
          </a>
        )}

      </div>
    </div>

    <div class="hero-header__right">
      <button class="hero-cta" data-scroll-to-rsvp>
        Get new sketchbooks
      </button>
    </div>

  </header>

      {/* 👉 BIO */}
      <Content />

{/* 👉 SKETCHBOOKS */}
{artistSketchbooks.length > 0 && (
  <section class="sketchbooks-section flow">
    <h2>Sketchbooks</h2>

    <div class="artist-sketchbooks">
      {artistSketchbooks.map((book) => {
        const pageCount = book.data.pages?.length ?? 0;
        const width = book.data.size_mm?.width ?? 148;
        const height = book.data.size_mm?.height ?? 210;

        return (
          <a
            class="artist-sketchbook"
            href={`/sketchbooks/${book.slug}`}
          >
            <div class="artist-sketchbook__book">
              <Book
                cover={book.data.cover}
                title={book.data.title}
                pagesCount={pageCount}
                width={width}
                height={height}
                scale={1}
                tilt={0.45}
                shadow={0.25}
              />
            </div>

            <div class="artist-sketchbook__meta">
              <div class="artist-sketchbook__title">
                {book.data.title}
              </div>

              <div class="artist-sketchbook__info">
                {[
                  book.data.year ? String(book.data.year) : null,
                  pageCount > 0 ? `${pageCount} pages` : null,
                ]
                  .filter(Boolean)
                  .join(" · ")}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

      {/* 👉 WORKS */}
      {galleryWorks.length > 0 && (
        <section class="gallery-section flow">
          <h2>Works</h2>
          <Gallery works={galleryWorks} />
        </section>
      )}

    </div>
  </section>

{/* ================================
   FOLLOW ARTIST CTA
================================ */}

<section class="section" id="rsvp">
  <div class="container">
    <div class="rsvp">

      <div class="rsvp__header">
        <h2 class="rsvp__title">
          Get new sketchbooks
        </h2>
      </div>

      <div class="rsvp__body">

        <p class="rsvp__note">
          Get new sketchbooks from this artist as soon as they’re published.
        </p>

        <div id="mlb2-39458049" class="rsvp__form ml-subscribe-form ml-subscribe-form-39458049">

          {/* 👉 ВАЖНО: row-form */}
          <div class="row-form">

            <form
              class="ml-block-form"
              action="https://assets.mailerlite.com/jsonp/1909692/forms/183874219513218877/subscribe"
              method="post"
            >
              <input
                type="email"
                name="fields[email]"
                placeholder="your email"
                required
                class="rsvp__input"
                autocomplete="email"
              />

              {/* 👉 передаём artist */}
              <input
                type="hidden"
                name="fields[artist]"
                value={artist.slug}
              />

              <button type="submit" class="rsvp__button">
                Follow this artist
              </button>

              <input type="hidden" name="ml-submit" value="1" />
              <input type="hidden" name="anticsrf" value="true" />
            </form>

          </div>

          {/* 👉 ВАЖНО: row-success */}
          <div class="row-success rsvp__success">
            <h4 class="rsvp__success-title">You're in ✨</h4>
            <p class="rsvp__success-text">
              We’ll send you new sketchbooks from this artist
            </p>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

</InternalLayout>

<style>
/* ================================
   HEADER
================================ */

.header {
  margin-bottom: 24px;
}

.artist-meta {
  display: flex;
  gap: 12px;
  align-items: center;
  font-size: 14px;
  opacity: 0.7;
}

/* ================================
   STYLE TAG
================================ */

.style {
  padding: 2px 8px;
  border-radius: 6px;
  background: rgba(0, 0, 0, 0.05);
}

/* ================================
   INSTAGRAM
================================ */

.instagram {
  text-decoration: none;
  color: inherit;
  border-bottom: 1px solid transparent;
}

.instagram:hover {
  border-color: currentColor;
}

/* ================================
   BIO
================================ */

.bio {
  opacity: 0.7;
  max-width: 600px;
}

/* ================================
   SECTIONS
================================ */

.sketchbooks-section,
.gallery-section,
.featured-section,
.collections-section,
.items-section {
  margin-top: 40px;
}

/* ================================
   MASONRY GRID (по умолчанию)
================================ */

.grid {
  column-width: 200px;
  column-gap: 16px;
  max-width: 900px;
}

/* ================================
   FEATURED — НЕ masonry
================================ */


.featured-section .grid {
  column-width: unset;
  column-gap: unset;

  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 320px));
  gap: 16px;

  max-width: 900px;
}

/* ================================
   CARD
================================ */

.card {
  display: inline-block; /* masonry */
  width: 100%;
  margin-bottom: 16px;

  text-decoration: none;
  color: inherit;

  transition: transform 0.15s ease;
}

.featured-section .card {
  display: block; /* 🔥 важно: убираем inline-block для grid */
  margin-bottom: 0;
}

.card:hover {
  transform: translateY(-2px);
}

/* ================================
   IMAGE
================================ */

.image {
  border-radius: 10px;
  overflow: hidden;
  background: #f5f5f5;
}

.image img {
  width: 100%;
  height: auto;
  display: block;
}

/* ================================
   META
================================ */

.meta {
  margin-top: 6px;
}

.title {
  font-size: 14px;
  line-height: 1.4;
}

.type {
  font-size: 11px;
  opacity: 0.5;
}

.sketchbooks-section {
  margin-top: 48px;
}


/* =========================
   GRID
========================= */

.sketchbooks-section {
  margin-top: 48px;
}


/* =========================
   GRID (фиксируем ширину сцены)
========================= */

.artist-sketchbooks {
  display: grid;

  grid-template-columns: repeat(auto-fit, minmax(160px, 220px));
  gap: 16px 20px;

  justify-content: start; /* 🔥 не растягиваем */
  align-items: end;

  max-width: 900px; /* 🔥 ограничили сцену */
}


/* =========================
   ITEM
========================= */

.artist-sketchbook {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;

  gap: 8px;

  text-decoration: none;
  color: inherit;
}


/* =========================
   BOOK (полка)
========================= */

.artist-sketchbook__book {
  position: relative;

  display: flex;
  align-items: flex-end;

  min-height: 150px;
}

.artist-sketchbook__book::after {
  content: "";

  position: absolute;
  left: 0;
  right: 0;
  bottom: -6px;

  height: 1px;
  background: rgba(0,0,0,0.15);
}


/* =========================
   META
========================= */

.artist-sketchbook__meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.artist-sketchbook__title {
  font-size: 15px;
  line-height: 1.2;
  font-weight: 500;
}

.artist-sketchbook__info {
  font-size: 13px;
  opacity: 0.6;
}


/* =========================
   HOVER
========================= */

.artist-sketchbook:hover .artist-sketchbook__title {
  text-decoration: underline;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {
  .artist-sketchbooks {
    grid-template-columns: repeat(2, minmax(140px, 1fr));
    gap: 14px 14px;
  }

  .artist-sketchbook__book {
    min-height: 120px;
  }
}

@media (max-width: 480px) {
  .artist-sketchbooks {
    grid-template-columns: 1fr;
  }

  .artist-sketchbook__book {
    min-height: auto;
  }
}
/* ================================
   RESPONSIVE
================================ */

@media (min-width: 768px) {
  .grid {
    column-width: 220px;
  }
}

@media (min-width: 1200px) {
  .grid {
    column-width: 240px;
  }
}
</style>

<script is:inline>
  function ml_webform_success_39458049() {
    const container = document.getElementById('mlb2-39458049');

    if (container instanceof HTMLElement) {
      container.classList.add('is-success');
    }
  }
</script>

<script
  is:inline
  src="https://groot.mailerlite.com/js/w/webforms.min.js"
></script>

<script is:inline>
  document.querySelectorAll('[data-scroll-to-rsvp]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = document.getElementById('rsvp');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });
</script>