---
export const prerender = true;
import InternalLayout from "@/layouts/InternalLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";
import { SEOBase } from "@/content/template/seo/seo";

/* ================================
   TYPES
================================ */

type Product = CollectionEntry<"products">;
type Collection = CollectionEntry<"productCollections">;
type Sketchbook = CollectionEntry<"sketchbooks">;

type Relation = Product["data"]["relations"][number];

/* ================================
   STATIC PATHS
================================ */

export async function getStaticPaths() {
  const collections = await getCollection("productCollections");

  return collections.map((collection) => ({
    params: { slug: collection.id },
    props: { collection },
  }));
}

/* ================================
   DATA
================================ */

const { collection } = Astro.props as { collection: Collection };
const { Content } = await render(collection);

const allProducts: Product[] = await getCollection("products");
const sketchbooks: Sketchbook[] = await getCollection("sketchbooks");

/* ================================
   HELPERS
================================ */

function hasPartOfCollection(
  product: Product,
  slug: string
): boolean {
  return product.data.relations?.some(
    (r) =>
      r.type === "part_of" &&
      r.target === "collection" &&
      r.slug === slug
  ) ?? false;
}

function getFromRelation(
  product: Product
): Relation | undefined {
  return product.data.relations?.find(
    (r) => r.type === "from"
  );
}

/* ================================
   PRODUCTS
================================ */

const products: Product[] = allProducts
  .filter((p) => hasPartOfCollection(p, collection.id))
  .sort((a, b) =>
    a.data.title.localeCompare(b.data.title)
  );

/* ================================
   SKETCHBOOK (из items)
================================ */

const firstFrom: Relation | undefined = products
  .map((p) => getFromRelation(p))
  .find(
    (r): r is Relation =>
      !!r && r.target === "sketchbook"
  );

const sketchbook: Sketchbook | undefined =
  firstFrom?.target === "sketchbook"
    ? sketchbooks.find((s) => s.id === firstFrom.slug)
    : undefined;

/* ================================
   SEO
================================ */

const pageSEO = {
  title: collection.data.title,
  description:
    collection.data.description ??
    collection.data.title,
};
---

<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>

  <section class="section">
    <div class="container flow">

      {/* HEADER */}
      <header class="header flow">
        <h1>{collection.data.title}</h1>
      </header>

      {/* COVER */}
      {collection.data.cover && (
        <div class="cover">
          <img
            src={collection.data.cover}
            alt={collection.data.title}
            loading="lazy"
          />
        </div>
      )}

      {/* DESCRIPTION */}
      <div class="description">
        <Content />
      </div>

      {/* CONTEXT */}
      {sketchbook && (
        <div class="context">
          <a href={`/sketchbooks/${sketchbook.id}`}>
            rooted in {sketchbook.data.title} →
          </a>
        </div>
      )}

      {/* PRODUCTS */}
      {products.length > 0 && (
        <section class="products">

          <h2 class="products__title">
            Objects from this series
          </h2>

          <div class="grid">
            {products.map((product) => {
              const from = getFromRelation(product);

              return (
                <a
                  href={`/items/${product.id}`}
                  class="card"
                >
                  <div class="image">
                    <img
                      src={product.data.image}
                      alt={product.data.title}
                      loading="lazy"
                    />
                  </div>

                  <div class="meta">

                    <div class="title">
                      {product.data.title}
                    </div>

                    {product.data.price && (
                      <div class="price">
                        {product.data.price.amount}{" "}
                        {product.data.price.currency}
                      </div>
                    )}

                    {from && (
                      <div class="hint">
                        from sketchbook
                      </div>
                    )}

                  </div>
                </a>
              );
            })}
          </div>

        </section>
      )}

    </div>
  </section>

</InternalLayout>

<style>

/* HEADER */
.header h1 {
  font-size: 28px;
  line-height: 1.2;
}

/* COVER */
.cover {
  margin: 16px 0 24px;
  max-width: 520px;
}

.cover img {
  width: 100%;
  border-radius: 12px;
}

/* DESCRIPTION */
.description {
  font-size: 16px;
  line-height: 1.6;
  opacity: 0.85;
  max-width: 560px;
}

/* CONTEXT */
.context {
  margin: 12px 0 24px;
  font-size: 14px;
}

.context a {
  text-decoration: underline;
}

/* PRODUCTS */
.products {
  margin-top: 32px;
}

.products__title {
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 16px;
}

/* GRID */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 16px;
}

/* CARD */
.card {
  text-decoration: none;
  color: inherit;
  display: block;
  transition: transform 0.15s ease;
}

.card:hover {
  transform: translateY(-2px);
}

/* IMAGE */
.image {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 10px;
  background: #f5f5f5;
}

.image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* META */
.meta {
  margin-top: 8px;
}

.title {
  font-size: 14px;
  line-height: 1.4;
}

.price {
  font-size: 14px;
  font-weight: 600;
  margin-top: 4px;
}

.hint {
  font-size: 11px;
  opacity: 0.5;
  margin-top: 2px;
}

</style>