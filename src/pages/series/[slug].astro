---
import InternalLayout from "@/layouts/InternalLayout.astro";
import { getCollection } from "astro:content";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";
import { SEOBase } from "@/content/template/seo/seo";

/* ================================
   STATIC PATHS
================================ */

export async function getStaticPaths() {
  const collections = await getCollection("productCollections");

  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

/* ================================
   DATA
================================ */

const { collection } = Astro.props;
const { Content } = await collection.render();

/* 👇 все продукты */
const allProducts = await getCollection("products");

/* 👇 фильтруем по collection */
const products = allProducts.filter(
  (p) => p.data.collection === collection.slug
);

/* 👇 сортировка (можешь потом поменять) */
products.sort((a, b) => a.data.title.localeCompare(b.data.title));

/* 👇 скетчбук (если есть) */
const sketchbooks = await getCollection("sketchbooks");

const sketchbook = collection.data.sketchbook
  ? sketchbooks.find(
      (s) => s.slug === collection.data.sketchbook
    )
  : null;

/* ================================
   SEO
================================ */

const pageSEO = {
  title: collection.data.title,
  description:
    collection.data.description ??
    collection.data.title,
};
---

<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>

  <section class="section">
    <div class="container flow">

      {/* ================================
          HEADER
      ================================= */}

      <header class="header flow">
        <h1>{collection.data.title}</h1>
      </header>

      {/* ================================
          COVER
      ================================= */}

      {collection.data.cover && (
        <div class="cover">
          <img
            src={collection.data.cover}
            alt={collection.data.title}
            loading="lazy"
          />
        </div>
      )}

      {/* ================================
          DESCRIPTION
      ================================= */}

      <div class="description">
        <Content />
      </div>

      {/* ================================
          SKETCHBOOK LINK
      ================================= */}

      {sketchbook && (
        <div class="sketchbook-link">
          <a href={`/sketchbooks/${sketchbook.slug}`}>
            View full sketchbook →
          </a>
        </div>
      )}

      {/* ================================
          PRODUCTS
      ================================= */}

      {products.length > 0 && (
        <section class="products">

          <h2 class="products__title">
            Prints from this series
          </h2>

          <div class="grid">
            {products.map((product) => (
              <a
                href={`/series/${product.slug}`}
                class="card"
              >
                <div class="image">
                  <img
                    src={product.data.image}
                    alt={product.data.title}
                    loading="lazy"
                  />
                </div>

                <div class="meta">
                  <div class="title">
                    {product.data.title}
                  </div>

                  {product.data.price && (
                    <div class="price">
                      {product.data.price} {product.data.currency}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>

        </section>
      )}

    </div>
  </section>

</InternalLayout>

<style>
/* ================================
   HEADER
================================ */

.header h1 {
  font-size: 28px;
  line-height: 1.2;
}

/* ================================
   COVER (FIX)
================================ */

.cover {
  margin: 16px 0 24px;

  max-width: 520px; /* 👈 ключ */
}

.cover img {
  width: 100%;
  height: auto;

  border-radius: 12px;
}

/* ================================
   DESCRIPTION
================================ */

.description {
  font-size: 16px;
  line-height: 1.6;
  opacity: 0.85;

  max-width: 560px;
}

/* ================================
   SKETCHBOOK LINK
================================ */

.sketchbook-link {
  margin: 12px 0 24px;
  font-size: 14px;
}

.sketchbook-link a {
  text-decoration: underline;
}

/* ================================
   PRODUCTS
================================ */

.products {
  margin-top: 32px;
}

.products__title {
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 16px;
}

/* ================================
   GRID
================================ */

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 16px;
}

/* ================================
   CARD
================================ */

.card {
  text-decoration: none;
  color: inherit;
  display: block;

  transition: transform 0.15s ease;
}

.card:hover {
  transform: translateY(-2px);
}

/* ================================
   IMAGE
================================ */

.image {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 10px;

  background: #f5f5f5;
}

.image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ================================
   META
================================ */

.meta {
  margin-top: 8px;
}

.title {
  font-size: 14px;
  line-height: 1.4;
}

.price {
  font-size: 14px;
  font-weight: 600;
  margin-top: 4px;
}
</style>