---
import BaseLayout from "@/layouts/baseLayout.astro";

import { SEOBase } from "@/content/template/seo/seo";
import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";


---

<BaseLayout
  baseSEO={SEOBase}
  pageSEO={{
    title: "Open Sketchbook Gallery – Flip Through Real Artists’ Sketchbooks",
    description:
      "Discover artists, flip through sketchbooks, and join open calls and local exhibitions.",

    og: {
    type: "website",
    image: "/og/open-sketchbooks.png",
    imageAlt: "Open Sketchbook Exhibition",
  },

  twitter: {
    card: "summary_large_image",
    image: "/og/open-sketchbooks.png",
  },
  }}

  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}

  logo={BrandLogo}
>

<section class="hero">

  <!-- коллаж -->
  <img src="/images/horse.png" class="heroLayer heroLayer--horse" />
  <img src="/images/stars.png" class="heroLayer heroLayer--stars" />
  <img src="/images/drops.png" class="heroLayer heroLayer--drops" />
  <img src="/images/flower.png" class="heroLayer heroLayer--flower" />

  <!-- карточка -->
<div class="paperMain">

  <!-- заголовок -->
<picture class="heroTitleImage">
  <source srcset="/images/title-night.png" media="(prefers-color-scheme: dark)" />
  <img src="/images/title.png" alt="Sketchbook Exhibition" />
</picture>

  <!-- инфо -->
  <div class="heroInfo">

    <p class="heroDate">
      June 27-28, 2026
    </p>

    <p class="heroPlace">Loft4</p>

    <p class="heroAddress">
      Batumi, Georgia
    </p>

    <p class="heroCurator">
      Curated by 
      <a 
        href="/artists/zhivov-vadim/"
      >
        MosTwo
      </a>
    </p>

  </div>

  <div class="heroButtons">
    <a
      href="https://form.typeform.com/to/TqR1yndz"
      class="heroButton heroButton--primary"
    >
      Open Call for Artists
    </a>
    <a
      href="/events/batumi-sketchbook-exhibition-summer-2026"
      class="heroButton heroButton--secondary"
    >
      Exhibition details
    </a>
  </div>

  <p class="heroOpenCallNote">Open call for artists is open until June 10</p>

</div>

</section> 

</BaseLayout>