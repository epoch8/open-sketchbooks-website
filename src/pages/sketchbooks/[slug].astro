---
import InternalLayout from "@/layouts/InternalLayout.astro";
import { getCollection } from "astro:content";

import { SEOBase } from "@/content/template/seo/seo";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";
import Book from "@/components/blocks/book/book.astro";

import SketchbookViewer from "@/components/blocks/sketchbook-viewer/SketchbookViewer.astro";

/* =========================
   STATIC PATHS
========================= */

export async function getStaticPaths() {
  const sketchbooks = await getCollection("sketchbooks");

  const published = sketchbooks.filter((b) => b.data.published === true);

  return published.map((book) => ({
    params: { slug: book.slug },
    props: {
      book,
      allSketchbooks: published,
    },
  }));
}

/* =========================
   DATA
========================= */

const { book, allSketchbooks } = Astro.props;

/* 🔥 ВАЖНО: рендер markdown */
const { Content } = await book.render();

/* 👤 author */
const artists = await getCollection("artists");

const artist = book.data.author
  ? artists.find((a) => a.slug === book.data.author)
  : null;

/* 📚 same author */
const sameAuthorSketchbooks =
  book.data.author
    ? allSketchbooks
        .filter(
          (b) =>
            b.slug !== book.slug &&
            b.data.author &&
            b.data.author === book.data.author
        )
        .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0))
        .slice(0, 4)
    : [];

const hasSameAuthor = sameAuthorSketchbooks.length > 0;

/* =========================
   RELATED (FROM FRONTMATTER)
========================= */

const relatedSketchbooks = (book.data.related ?? [])
  .map((rel) =>
    allSketchbooks.find((b) => b.slug === rel.slug)
  )
  .filter((b): b is (typeof allSketchbooks)[number] => Boolean(b))
  .slice(0, 6);
  
const artistMap = Object.fromEntries(
  artists.map((a) => [a.slug, a])
);

/* 📂 pages */
const pages = book.data.pages ?? [];
const featured = book.data.featured ?? [];

/* SEO оставляем как есть */
const base = "https://open-sketchbook.place";

const pageSEO = {
  title: book.data.title,
  description: book.data.seoDescription ?? book.data.title,
  og: {
    image: `${base}/og/sketchbooks/${book.slug}.png`,
  },
};
---

<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>
  <main class="sketchbook">

    {/* =========================
        HERO
    ========================= */}

    <section class="sketchbook-hero">
      <div class="sketchbook-hero__grid">

        <div class="sketchbook-hero__info">
          <h1 class="sketchbook-hero__title">{book.data.title}</h1>

          {artist && (
            <div class="sketchbook-hero__author">
              by {artist.data.title}
            </div>
          )}

          <div class="sketchbook-hero__meta">
            {pages.length} pages
          </div>

          <div class="sketchbook-hero__divider" />
        </div>

        <div class="sketchbook-hero__cover">
          <Book
            cover={book.data.cover}
            title={book.data.title}
            pagesCount={pages.length}
            height={book.data.size_mm?.height ?? 210}
            width={book.data.size_mm?.width ?? 148}
            tilt={0.5}
          />
        </div>

      </div>
    </section>


    {/* =========================
        VIEWER
    ========================= */}

    <section class="sketchbook-viewer">

      {/* SIDEBAR */}
      <aside class="sketchbook-viewer__sidebar">
        <div class="sketchbook-viewer__sidebar-inner" id="sidebarInner">

          {/* 🔥 DESCRIPTION ИЗ MD */}
          <div class="sketchbook-viewer__block">
            <div class="sketchbook-viewer__label">Description</div>

            <div class="sketchbook-viewer__description">
              <Content />
            </div>

          </div>

          {/* SAME AUTHOR */}
          {hasSameAuthor && (
            <div class="sketchbook-viewer__block">
              
              <div class="sketchbook-viewer__label">
                Other sketchbooks by {artist?.data.title}
              </div>

              <div class="sketchbook-related-list">
                {sameAuthorSketchbooks.map((b) => (
                  <a
                    href={`/sketchbooks/${b.slug}`}
                    class="sketchbook-related-item"
                  >

{b.data.cover && (
  <div class="sketchbook-related-item__book">
    <Book
      cover={b.data.cover}
      title={b.data.title}
      pagesCount={b.data.pages?.length ?? 0}
      width={b.data.size_mm?.width ?? 148}
      height={b.data.size_mm?.height ?? 210}
      scale={1}
      tilt={0.2}
      shadow={0}
    />
  </div>
)}

                    <div class="meta">
                      <div class="title">{b.data.title}</div>
                      <div class="info">
                        {b.data.year ?? ""} · {b.data.pages?.length ?? 0} pages
                      </div>
                    </div>

                  </a>
                ))}
              </div>

            </div>
          )}

        </div>
      </aside>


      {/* CONTENT */}
      <div class="sketchbook-viewer__content">

        <div class="sketchbook-viewer__topbar" id="topbar">
          <div class="sketchbook-viewer__topbar-inner">
            <div class="sketchbook-viewer__topbar-label">
              A selection of pages from the sketchbook
            </div>

            <button
              class="sketchbook-viewer__topbar-button"
              onclick={`window.SketchbookViewer.open('sketchbook-${book.slug}', 0)`}
            >
              View full sketchbook
            </button>
          </div>
        </div>

        <div class="sketchbook-pages" id="pages">
          {featured.map((p) => (
            <div class="sketchbook-page">
              <img src={p.src} alt="" loading="lazy" />
            </div>
          ))}
        </div>

      </div>

    </section>

    {/* =========================
    EXPLORE
========================= */}

{relatedSketchbooks.length > 0 && (
  <section class="sketchbook-explore">

    <div class="sketchbook-explore__divider" />

    <div class="sketchbook-explore__inner">

      <h2 class="sketchbook-explore__title">
        More sketchbooks to explore
      </h2>

      <div class="sketchbook-explore__grid">
        {relatedSketchbooks.map((b) => {
          const author =
            b.data.author
              ? artistMap[b.data.author]
              : undefined;

          const pagesCount = b.data.pages?.length ?? 0;

          return (
            <a
              href={`/sketchbooks/${b.slug}`}
              class="sketchbook-explore__item"
            >
              {b.data.cover && (
                <div class="sketchbook-explore__book">
                  <Book
                    cover={b.data.cover}
                    title={b.data.title}
                    pagesCount={pagesCount}
                    width={b.data.size_mm?.width ?? 148}
                    height={b.data.size_mm?.height ?? 210}
                    scale={1}
                    tilt={0.2}
                    shadow={0}
                  />
                </div>
              )}

              <div class="meta">
                <div class="title">{b.data.title}</div>

                <div class="info">
                  {author?.data.title
                    ? `by ${author.data.title} · `
                    : ""}
                  {pagesCount} pages
                </div>
              </div>
            </a>
          );
        })}
      </div>

    </div>

  </section>
)}

  </main>
</InternalLayout>



  {/* =========================
      VIEWER OVERLAY
  ========================= */}

  <SketchbookViewer
    slot="overlay"
    viewerId={`sketchbook-${book.slug}`}
    pages={pages}
    title={book.data.title}
    author={
      artist
        ? {
            name: artist.data.title,
            url: `/artists/${artist.slug}`,
          }
        : undefined
    }
  />

</InternalLayout>

<style>

/* =========================
   GLOBAL
========================= */

.sketchbook {
  display: flex;
  flex-direction: column;
}


/* =========================
   HERO
========================= */

.sketchbook-hero {
  padding: 64px 0 32px;
}

.sketchbook-hero__grid {
  display: grid;
  grid-template-columns: 2fr 2fr 2fr;
  gap: 16px;
  align-items: end;
  width: 100%;
}

.sketchbook-hero__info {
  grid-column: span 2;
  display: flex;
  flex-direction: column;
}

.sketchbook-hero__title {
  font-size: clamp(36px, 4.5vw, 72px);
  line-height: 1;
  font-weight: 700;
}

.sketchbook-hero__author {
  margin-top: 8px;
  font-size: 16px;
  opacity: 0.7;
}

.sketchbook-hero__meta {
  margin-top: 4px;
  font-size: 14px;
  opacity: 0.5;
}


/* =========================
   BOOK
========================= */

.sketchbook-hero__cover {
  grid-column: 3;

  display: flex;
  justify-content: flex-end;
  align-items: flex-end;

  --book-size: 100px;
}

.sketchbook-hero__cover .book {
  width: var(--book-size);
  height: auto;
}


/* =========================
   VIEWER LAYOUT
========================= */

.sketchbook-viewer {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 64px;
}

.sketchbook-viewer__sidebar {
  border-top: 1px solid #000;
  padding-top: 24px;
}

.sketchbook-viewer__content {
  border-top: none;
}


/* =========================
   SIDEBAR (NO STICKY)
========================= */

.sketchbook-viewer__sidebar-inner {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.sketchbook-viewer__block {
  display: flex;
  flex-direction: column;
}

.sketchbook-viewer__label {
  font-size: 11px;
  text-transform: uppercase;
  margin-bottom: 6px;
  opacity: 0.5;
}


/* =========================
   DESCRIPTION
========================= */

.sketchbook-viewer__description {
  font-size: 14px;
  line-height: 1.5;
}

.sketchbook-viewer__description h1,
.sketchbook-viewer__description h2,
.sketchbook-viewer__description h3 {
  font-size: 16px;
  margin: 12px 0 6px;
}

.sketchbook-viewer__description p {
  margin: 0 0 10px;
}


/* =========================
   SAME AUTHOR
========================= */

.sketchbook-related-list {
  display: grid;
  gap: 16px;
}

.sketchbook-related-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
  text-decoration: none;
  color: inherit;
}

.sketchbook-related-item img {
  width: 100%;
  max-width: 140px;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  border: 1px solid rgba(0,0,0,0.1);
}

.sketchbook-related-item .meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.sketchbook-related-item .title {
  font-size: 14px;
  line-height: 1.2;
}

.sketchbook-related-item .info {
  font-size: 12px;
  opacity: 0.6;
}


/* =========================
   TOPBAR
========================= */

.sketchbook-viewer__topbar {
  position: sticky;
  top: 0;
  z-index: 30;

  background: var(--color-bg);
  border-top: 1px solid #000;
  border-bottom: 1px solid #000;
}

.sketchbook-viewer__topbar-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: stretch;
  min-height: 60px;
}

.sketchbook-viewer__topbar-label {
  display: flex;
  align-items: center;
  padding-right: 32px;

  font-size: 14px;
  opacity: 0.6;
  white-space: nowrap;
}

.sketchbook-viewer__topbar-button {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 360px;
  max-width: 40vw;
  padding: 0 32px;

  background: #fff;
  color: #000;

  border-left: 1px solid #000;
  border-right: 1px solid #000;

  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 16px;
  font-weight: 600;

  cursor: pointer;
  transition: 0.2s;
}

.sketchbook-viewer__topbar-button:hover {
  background: #000;
  color: #fff;
}


/* =========================
   PAGES
========================= */

.sketchbook-pages {
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding: 24px 0 48px;
}

.sketchbook-page img {
  width: 100%;
  display: block;
}

/* =========================
   EXPLORE BLOCK
========================= */

.sketchbook-explore {
  margin-top: 80px;
  margin-bottom: 80px;
}

/* линия сверху */
.sketchbook-explore__divider {
  width: 100%;
  height: 1px;
  background: #000;
  margin-bottom: 32px;
}

.sketchbook-explore__inner {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* заголовок */
.sketchbook-explore__title {
  font-size: 20px;
  font-weight: 600;
}


/* =========================
   SHELF (ГЛАВНОЕ)
========================= */

.sketchbook-explore__grid {
  display: flex;
  gap: 28px;

  align-items: flex-end;

  /* 🔥 горизонтальный скролл */
  overflow-x: auto;
  overflow-y: hidden;

  padding-bottom: 12px;
}

/* 🔥 “полка” */
.sketchbook-explore__grid::after {
  content: "";
  position: sticky;
  left: 0;
  right: 0;
  bottom: 0;

  height: 1px;
  background: rgba(0,0,0,0.2);
}


/* =========================
   ITEM
========================= */

.sketchbook-explore__item {
  flex: 0 0 auto;

  display: flex;
  flex-direction: column;
  gap: 10px;

  text-decoration: none;
  color: inherit;

  min-width: 120px;
}


/* книга стоит на “полке” */
.sketchbook-explore__book {
  display: flex;
  align-items: flex-end;
  justify-content: center;

  min-height: 160px; /* 👈 вместо height */
}

/* ограничиваем размер книги */
.sketchbook-explore__book .book {
  height: 100%;
  width: auto;
}


/* =========================
   META
========================= */

.sketchbook-explore__item .meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.sketchbook-explore__item .title {
  font-size: 14px;
  line-height: 1.2;
}

.sketchbook-explore__item .info {
  font-size: 12px;
  opacity: 0.6;
}


/* =========================
   HOVER (чуть жизни)
========================= */

.sketchbook-explore__item:hover .book {
  transform: translateY(-4px);
  transition: transform 0.2s ease;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {
  /* =========================
     EXPLORE (MOBILE FIX)
  ========================= */

  .sketchbook-explore {
    margin-top: 48px;
    margin-bottom: 48px;
  }

  .sketchbook-explore__title {
    font-size: 18px;
  }

  /* 🔥 убиваем горизонтальную полку */
  .sketchbook-explore__grid {
    display: flex;
    flex-direction: column; /* 👈 ключ */
    gap: 20px;

    overflow: visible; /* 👈 критично */
    padding-bottom: 0;
  }

  .sketchbook-explore__inner {
  align-items: flex-start; /* 👈 ключ */
}

  /* 🔥 item становится строкой */
  .sketchbook-explore__item {
    flex-direction: row;
    align-items: center;
    gap: 16px;

    min-width: 0; /* 👈 убираем фикс */
  }

  /* 🔥 книжка слева */
  .sketchbook-explore__book {
    min-height: 0;
    height: auto;

    flex: 0 0 80px; /* 👈 фикс ширины */
    display: flex;
    align-items: flex-end;
  }

  .sketchbook-explore__book .book {
    width: 100%;
    height: auto;
  }

  /* 🔥 текст справа */
  .sketchbook-explore__item .meta {
    flex: 1;
  }

  /* HERO */
  .sketchbook-hero__grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .sketchbook-hero__cover {
    order: 2;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .sketchbook-hero__cover .book {
    margin-top: 8px;
  }

  /* VIEWER STACK */
  .sketchbook-viewer {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .sketchbook-viewer__content {
    order: 1;
  }

  .sketchbook-viewer__sidebar {
    order: 2;
  }

  /* TOPBAR */
  .sketchbook-viewer__topbar-inner {
    grid-template-columns: 1fr;
  }

  .sketchbook-viewer__topbar-label {
    padding: 12px 0;
    white-space: normal;
  }

  .sketchbook-viewer__topbar-button {
    width: 100%;
    max-width: none;
    min-height: 72px;

    border-left: none;
    border-right: none;
  }
}

</style>