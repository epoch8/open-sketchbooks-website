---
import InternalLayout from "@/layouts/InternalLayout.astro";
import { getCollection } from "astro:content";

import { SEOBase } from "@/content/template/seo/seo";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";
import SketchbookViewer from "@/components/blocks/sketchbook-viewer/SketchbookViewer.astro";

export async function getStaticPaths() {
  const sketchbooks = await getCollection("sketchbooks");

  return sketchbooks
    .filter((book) => book.data.published === true)
    .map((book) => ({
      params: { slug: book.slug },
      props: { book },
    }));
}

const { book } = Astro.props;

/* 👤 author */
const artists = await getCollection("artists");

const artist = book.data.author
  ? artists.find((a) => a.slug === book.data.author)
  : null;

/* 📂 pages */
const pages = book.data.pages ?? [];

/* SEO */
const pageSEO = {
  title: book.data.title,
  description: book.data.seoDescription ?? book.data.title,
};
---


<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>
  <main class="sketchbook">

    <section class="sketchbook-hero">
      <div class="sketchbook-hero__grid">
        <div class="sketchbook-hero__info">
          <h1 class="sketchbook-hero__title">{book.data.title}</h1>

          {artist && (
            <div class="sketchbook-hero__author">
              by {artist.data.title}
            </div>
          )}

          <div class="sketchbook-hero__meta">
            {pages.length} pages
          </div>

          <div class="sketchbook-hero__divider" />
        </div>

        <div class="sketchbook-hero__cover">
          {book.data.cover && (
            <img src={book.data.cover} alt={book.data.title} />
          )}
        </div>
      </div>
    </section>

    <section class="sketchbook-viewer">
      <aside class="sketchbook-viewer__sidebar">
        <div class="sketchbook-viewer__sidebar-inner">
          <div class="sketchbook-viewer__block">
            <div class="sketchbook-viewer__label">Description</div>
            <p>{book.data.seoDescription ?? "No description yet."}</p>
          </div>

          <div class="sketchbook-viewer__block">
            <div class="sketchbook-viewer__label">Info</div>
            <p>
              {book.data.year} <br />
              {pages.length} pages
            </p>
          </div>
        </div>
      </aside>

      <div class="sketchbook-viewer__content">
        <div class="sketchbook-viewer__topbar">
          <button
            onclick={`window.SketchbookViewer.open('sketchbook-${book.slug}', 0)`}
          >
            View full sketchbook
          </button>
        </div>

        <div class="sketchbook-pages">
          {pages.map((p) => (
            <div class="sketchbook-page">
              <img src={p.src} alt="" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>

  <SketchbookViewer
    slot="overlay"
    viewerId={`sketchbook-${book.slug}`}
    pages={pages}
    title={book.data.title}
  />
</InternalLayout>


<style>

/* =========================
   GLOBAL
========================= */

.sketchbook {
  display: flex;
  flex-direction: column;
}


/* =========================
   HERO (COMPACT)
========================= */

.sketchbook-hero {
  padding: 64px 0 32px; /* было implicit через vh */
}

/* ❌ удаляем */
.sketchbook-hero__divider {
  display: none;
}

.sketchbook-hero__grid {
  display: grid;
grid-template-columns: 2fr 2fr 2fr;
  gap: 8px;
  align-items: end;
  width: 100%;
}

.sketchbook-hero__info {
  grid-column: span 2; /* 🔥 занимает 1+2 колонку */
  display: flex;
  flex-direction: column;
}

/* 👇 уменьшили заголовок */
.sketchbook-hero__title {
  font-size: clamp(36px, 4.5vw, 72px);
  line-height: 1;
  font-weight: 700;
}

/* 👇 tighter stack */
.sketchbook-hero__author {
  margin-top: 8px;
  font-size: 16px;
  opacity: 0.7;
}

.sketchbook-hero__meta {
  margin-top: 4px;
  font-size: 14px;
  opacity: 0.5;
}

/* 👇 ещё компактнее */
.sketchbook-hero__divider {
  height: 1px;
  background: black;
  margin: 16px 0;
  width: 100%;
}

.sketchbook-hero__cover {
  grid-column: 3;
}

/* 👇 уменьшаем и поджимаем обложку */
.sketchbook-hero__cover img {
  width: 100%;
  max-width: 240px;
  display: block;
  /* ❌ margin-left: auto; убрали */
}


/* =========================
   VIEWER
========================= */

.sketchbook-viewer {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 16px;
}

.sketchbook-viewer__topbar {
  position: sticky;
  top: 0;
  height: 80px;              /* 🔥 фиксируем */
  display: flex;
  align-items: center;       /* центрируем кнопку по вертикали */
  justify-content: flex-end;

  padding: 0;                /* убираем padding */
  background: white;
  border-bottom: 1px solid #eee;
  z-index: 10;
}
.sketchbook-viewer__sidebar {
  border-top: 1px solid #000; /* 🔥 новая линия */
  padding-top: 24px;          /* чтобы не прилипало */
}

.sketchbook-viewer__content {
  border-top: 1px solid #000; /* 🔥 новая линия */
}

/* =========================
   SIDEBAR
========================= */

.sketchbook-viewer__sidebar-inner {
  position: sticky;
  top: 100px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.sketchbook-viewer__label {
  font-size: 11px;
  text-transform: uppercase;
  margin-bottom: 6px;
  opacity: 0.5;
}


/* =========================
   CONTENT
========================= */

.sketchbook-viewer__topbar {
  position: sticky;
  top: 0;
  background: white;
  z-index: 10;

  display: flex;
  justify-content: flex-end;

  padding: 16px 0;
  border-bottom: 1px solid #eee;
}

.sketchbook-viewer__cta {
  padding: 16px 28px;
  font-size: 16px;
  background: black;
  color: white;
  border: none;
}


/* =========================
   PAGES
========================= */

.sketchbook-pages {
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding: 24px 0 48px;
}

.sketchbook-page img {
  width: 100%;
  display: block;
}

</style>