---
import InternalLayout from "@/layouts/InternalLayout.astro";
import { getCollection } from "astro:content";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";
import { SEOBase } from "@/content/template/seo/seo";

export async function getStaticPaths() {
  const sketchbooks = await getCollection("sketchbooks");

  return sketchbooks.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await book.render();

const rawPages = book.data.pages ?? [];

const pages = rawPages.map((p, i) => ({
  src: `${p.src}`,
  caption: p.caption,
  aspect: p.aspect ?? book.data.defaultAspect ?? "portrait",
  index: i + 1,
}));

const featuredPages = pages.slice(0, 5);

const isAvailable = book.data.format?.digital ?? false;
const pageCount = pages.length;

const pageSEO = {
  title: book.data.title,
  description: book.data.seoDescription ?? book.data.title,
};
---

<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>

<section class="section">
<div class="container">

  {/* =========================
      HERO (A24 style)
  ========================== */}

  <section class="book-hero">

    <div class="book-hero__grid">

      {/* LEFT */}
      <div class="book-hero__left">
        <h1 class="book-title">
          {book.data.title}
        </h1>
      </div>

      {/* RIGHT */}
      <div class="book-hero__right">
        {book.data.cover && (
          <div class="book-cover">
            <img src={book.data.cover} alt={book.data.title} />
          </div>
        )}
      </div>

    </div>

    {/* BOTTOM */}
    <div class="book-hero__bottom">

      <div class="book-description">
        <Content />
      </div>

      <div class="book-meta">
        {book.data.year && <div>{book.data.year}</div>}
        {pageCount > 0 && <div>{pageCount} pages</div>}
        {book.data.format?.physical && <div>physical</div>}
        {book.data.format?.digital && <div>digital</div>}
      </div>

      {isAvailable && (
        <div class="book-cta">
          <button class="button-hero" data-open-viewer>
            View full sketchbook
          </button>
        </div>
      )}

    </div>

  </section>

  {/* =========================
      PREVIEW (featured pages)
  ========================== */}

  {isAvailable && (
    <section class="book-preview">

      {/* TOP BAR */}
      <div class="preview-topbar">
        <div class="preview-topbar__inner">
          <span>Sketchbook preview</span>

          <button class="button-preview" data-open-viewer>
            View full sketchbook
          </button>
        </div>
      </div>

      <div class="preview-grid">

        {/* LEFT */}
        <aside class="preview-sidebar">
          <div class="preview-sidebar__inner">

            <h2>About</h2>

            <div class="preview-description">
              <Content />
            </div>

          </div>
        </aside>

        {/* RIGHT */}
        <div class="preview-pages">
          <div class="preview-pages__inner">

            {featuredPages.map((page) => (
              <figure class="preview-page">
                <img src={page.src} alt="" />
              </figure>
            ))}

          </div>
        </div>

      </div>

    </section>
  )}

  {/* =========================
      VIEWER (fullscreen)
  ========================== */}

  {isAvailable && (
    <div class="viewer-modal" id="viewerModal">

      <div class="viewer-backdrop" data-close-viewer />

      <div class="viewer-panel">

        <div class="viewer-topbar">
          <span>{book.data.title}</span>
          <button data-close-viewer>✕</button>
        </div>

        <div class="viewer-track" id="track">

          {pages.map((page) => (
            <div class="viewer-page">
              <img src={page.src} />
            </div>
          ))}

        </div>

      </div>

    </div>
  )}

</div>
</section>

</InternalLayout>

<script>
const modal = document.getElementById("viewerModal");

document.querySelectorAll("[data-open-viewer]").forEach(btn => {
  btn.addEventListener("click", () => {
    modal?.classList.add("is-open");
    document.body.style.overflow = "hidden";
  });
});

document.querySelectorAll("[data-close-viewer]").forEach(btn => {
  btn.addEventListener("click", () => {
    modal?.classList.remove("is-open");
    document.body.style.overflow = "";
  });
});
</script>

<style>

/* =========================
   HERO
========================= */

.book-hero {
  min-height: 85vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.book-hero__grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  align-items: center;
}

.book-title {
  font-size: clamp(48px, 8vw, 120px);
  line-height: 0.9;
}

.book-cover {
  max-width: 360px;
  margin-left: auto;
}

.book-hero__bottom {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  gap: 32px;
}

.button-hero {
  padding: 20px 32px;
  font-size: 18px;
  background: black;
  color: white;
}

/* =========================
   PREVIEW
========================= */

.preview-topbar {
  position: sticky;
  top: 0;
  background: white;
  z-index: 10;
}

.preview-topbar__inner {
  display: flex;
  justify-content: space-between;
  padding: 16px 0;
}

.preview-grid {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 64px;
}

.preview-sidebar__inner {
  position: sticky;
  top: 120px;
}

.preview-pages__inner {
  display: flex;
  flex-direction: column;
  gap: 80px;
}

.preview-page img {
  width: 100%;
  max-width: 900px;
}

/* =========================
   VIEWER
========================= */

.viewer-modal {
  position: fixed;
  inset: 0;
  display: none;
}

.viewer-modal.is-open {
  display: block;
}

.viewer-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.8);
}

.viewer-panel {
  position: absolute;
  inset: 0;
  background: white;
  display: flex;
  flex-direction: column;
}

.viewer-track {
  display: flex;
  gap: 40px;
  overflow-x: scroll;
  padding: 40px;
}

.viewer-page img {
  max-height: 80vh;
}

</style>