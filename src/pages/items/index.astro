---
import InternalLayout from "@/layouts/InternalLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";
import { SEOBase } from "@/content/template/seo/seo";

/* ================================
   TYPES
================================ */

type Product = CollectionEntry<"products">;
type Artist = CollectionEntry<"artists">;

type Relation = Product["data"]["relations"][number];
type RelationType = Relation["type"];

/* ================================
   DATA
================================ */

const allProducts: Product[] = await getCollection("products");
const artists: Artist[] = await getCollection("artists");

/* ================================
   HELPERS
================================ */

function getArtist(slug: string): Artist | undefined {
  return artists.find((a) => a.slug === slug);
}

function getRelation(
  product: Product,
  type: RelationType
): Relation | undefined {
  return product.data.relations?.find((r) => r.type === type);
}

function hasRelation(
  product: Product,
  type: RelationType
): boolean {
  return product.data.relations?.some((r) => r.type === type) ?? false;
}

/* ================================
   FILTERING
================================ */

/* 👇 можно включить позже */
const products: Product[] = allProducts
  // .filter((p) => hasRelation(p, "from") || hasRelation(p, "part_of"))
  .sort((a, b) =>
    a.data.title.localeCompare(b.data.title)
  );

/* ================================
   SEO
================================ */

const pageSEO = {
  title: "All works",
  description: "All sketchbook-based works and prints",
};
---

<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>

  <section class="section">
    <div class="container flow">

      {/* ================================
          HEADER
      ================================= */}

      <header class="header">
        <h1>All works</h1>
      </header>

      {/* ================================
          GRID
      ================================= */}

      <section class="grid">

        {products.map((product) => {
          const artist = getArtist(product.data.artist);

          const from = getRelation(product, "from");
          const partOf = getRelation(product, "part_of");

          return (
            <a
              href={`/items/${product.slug}`}
              class="card"
            >
              {/* IMAGE */}
              <div class="image">
                <img
                  src={product.data.image}
                  alt={product.data.title}
                  loading="lazy"
                />
              </div>

              {/* META */}
              <div class="meta">

                <div class="title">
                  {product.data.title}
                </div>

                {artist && (
                  <div class="artist">
                    {artist.data.title}
                  </div>
                )}

                {product.data.price && (
                  <div class="price">
                    {product.data.price.amount}{" "}
                    {product.data.price.currency}
                  </div>
                )}

                {/* 🔗 смысловой намёк */}
                <div class="relation-hint">

                  {from && (
                    <span class="hint hint--from">
                      from sketchbook
                    </span>
                  )}

                  {!from && partOf && (
                    <span class="hint hint--collection">
                      part of series
                    </span>
                  )}

                </div>

              </div>
            </a>
          );
        })}

      </section>

    </div>
  </section>

</InternalLayout>

<style>

/* ================================
   HEADER
================================ */

.header h1 {
  font-size: 28px;
  line-height: 1.2;
}

/* ================================
   GRID
================================ */

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 20px;
}

/* ================================
   CARD
================================ */

.card {
  display: block;
  text-decoration: none;
  color: inherit;

  transition: transform 0.15s ease;
}

.card:hover {
  transform: translateY(-2px);
}

/* ================================
   IMAGE
================================ */

.image {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 10px;
  background: #f5f5f5;
}

.image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ================================
   META
================================ */

.meta {
  margin-top: 8px;
}

.title {
  font-size: 14px;
  line-height: 1.4;
}

.artist {
  font-size: 13px;
  opacity: 0.6;
  margin-top: 2px;
}

.price {
  font-size: 14px;
  font-weight: 600;
  margin-top: 4px;
}

/* ================================
   RELATION HINT
================================ */

.relation-hint {
  margin-top: 4px;
  font-size: 11px;
  opacity: 0.5;
}

.hint--from {
  opacity: 0.7;
}

</style>