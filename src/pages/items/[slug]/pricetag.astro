---
export const prerender = true;
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

/* ================================
   DATA
================================ */

const artists = await getCollection("artists");

const artist = product.data.artist
  ? artists.find((a) => a.id === product.data.artist)
  : null;

/* 💳 payment */
const paymentMethods = artist?.data.paymentMethods ?? [];

const linkMethods = paymentMethods.filter((m) => m.type === "link");
const otherMethods = paymentMethods.filter((m) => m.type !== "link");

/* 🔗 relations */
const relations = product.data.relations ?? [];

const from = relations.find((r) => r.type === "from");
const partOf = relations.find(
  (r) => r.type === "part_of" && r.target === "collection"
);

/* 📚 */
const sketchbooks = await getCollection("sketchbooks");
const collections = await getCollection("productCollections");

const fromSketchbook =
  from?.target === "sketchbook"
    ? sketchbooks.find((s) => s.id === from.slug)
    : null;

const collection =
  partOf?.target === "collection"
    ? collections.find((c) => c.id === partOf.slug)
    : null;

/* 🔗 */
const artistUrl = artist
  ? `https://open-sketchbook.place/artists/${artist.id}`
  : null;
---

<html>
  <head>
    <meta charset="utf-8" />
    <title>{product.data.title} – Pricetag</title>

    <style>
      @page {
        size: A6;
        margin: 0;
      }

      body {
        margin: 0;
        font-family: system-ui;
      }

      .sheet {
        width: 105mm;
        height: 148mm;
        padding: 10mm;

        display: flex;
        flex-direction: column;

        box-sizing: border-box;
      }

      /* HEADER */

      .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
      }

      .title {
        font-size: 18px;
        font-weight: 600;
      }

      .artist {
        font-size: 14px;
        opacity: 0.7;
        margin-top: 4px;
      }

      .artist-qr {
        width: 48px;
        height: 48px;
      }

      /* 🔥 CONTEXT ПЕРЕНЕСЕН СЮДА */

      .context {
        margin-top: 6px;
        font-size: 12px;
        opacity: 0.6;
      }

      /* PRICE */

      .price {
        font-size: 28px;
        font-weight: 700;
        margin-top: 16px;
      }

      /* PAYMENTS */

      .payments-wrapper {
        margin-top: 36px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .payments-title {
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        opacity: 0.9;
      }

      .payment-qr-row {
        display: flex;
        gap: 16px;
      }

      .payment-qr {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .qr {
        width: 90px;
        height: 90px;
      }

      .label {
        font-size: 11px;
        opacity: 0.7;
      }

      .payment-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .payment-row {
        display: flex;
        gap: 10px;
        font-size: 15px;
        line-height: 1.35;
      }

      .payment-row__label {
        opacity: 0.6;
        white-space: nowrap;
      }

      .payment-row__value {
        font-weight: 600;
        word-break: break-all;
      }

      .footer {
        font-size: 10px;
        opacity: 0.5;
        margin-top: 46px;
      }

      @media screen {
        body {
          background: #eee;
          display: flex;
          justify-content: center;
        }

        .sheet {
          background: white;
          margin: 40px 0;
        }
      }
    </style>
  </head>

  <body>
    <div class="sheet">

      {/* HEADER */}
      <div>

        <div class="header">

          <div>
            <div class="title">{product.data.title}</div>

            {artist && (
              <div class="artist">
                by {artist.data.title}
              </div>
            )}

            {/* 🔥 ТЕПЕРЬ ЗДЕСЬ */}
            <div class="context">
              {fromSketchbook && (
                <div>
                  from {fromSketchbook.data.title}
                  {from?.page && ` (page ${from.page})`}
                </div>
              )}

              {!fromSketchbook && collection && (
                <div>
                  part of {collection.data.title}
                </div>
              )}
            </div>

          </div>

          {artistUrl && (
            <img
              class="artist-qr"
              src={`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(artistUrl)}`}
            />
          )}

        </div>

        {/* PRICE */}
        {product.data.price && (
          <div class="price">
            {product.data.price.amount} {product.data.price.currency}
          </div>
        )}

      </div>

      {/* PAYMENTS */}
      {paymentMethods.length > 0 && (
        <div class="payments-wrapper">

          <div class="payments-title">
            Payment
          </div>

          {linkMethods.length > 0 && (
            <div class="payment-qr-row">
              {linkMethods.map((method) => (
                <div class="payment-qr">

                  <img
                    class="qr"
                    src={`https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=${encodeURIComponent(method.url)}`}
                  />

                  <div class="label">
                    {method.title}
                  </div>

                </div>
              ))}
            </div>
          )}

          {otherMethods.length > 0 && (
            <div class="payment-list">

              {otherMethods.map((method) => (
                <div class="payment-row">

                  <div class="payment-row__label">
                    {method.title}
                  </div>

                  <div class="payment-row__value">
                    {method.type === "account" && method.accountNumber}
                    {method.type === "card" && method.cardNumber}
                    {method.type === "cash" && (method.description ?? "Cash")}
                  </div>

                </div>
              ))}

            </div>
          )}

        </div>
      )}

      <div class="footer">
        open-sketchbook.place
      </div>

    </div>
  </body>
</html>