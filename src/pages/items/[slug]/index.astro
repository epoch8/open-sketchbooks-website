---
import InternalLayout from "@/layouts/InternalLayout.astro";
import { getCollection } from "astro:content";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";
import { SEOBase } from "@/content/template/seo/seo";

/* ================================
   STATIC PATHS
================================ */

export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

/* ================================
   DATA
================================ */

const { product } = Astro.props;
const { Content } = await product.render();

/* 👇 все продукты */
const allProducts = await getCollection("products");

/* ================================
   RELATIONS HELPERS
================================ */

const relations = product.data.relations ?? [];

/* 🔴 from */
const from = relations.find((r) => r.type === "from");

/* 🔵 part_of (collection) */
const collectionRel = relations.find(
  (r) => r.type === "part_of" && r.target === "collection"
);

/* 🟡 related */
const relatedRels = relations.filter((r) => r.type === "related");

/* ================================
   COLLECTION ENTITY
================================ */

const collections = await getCollection("productCollections");

const collection = collectionRel
  ? collections.find((c) => c.slug === collectionRel.slug)
  : null;

/* ================================
   SKETCHBOOK ENTITY
================================ */

const sketchbooks = await getCollection("sketchbooks");

const fromSketchbook =
  from?.target === "sketchbook"
    ? sketchbooks.find((s) => s.slug === from.slug)
    : null;

/* ================================
   ARTIST
================================ */

const artists = await getCollection("artists");

const artist = product.data.artist
  ? artists.find((a) => a.slug === product.data.artist)
  : null;

/* ================================
   RELATED PRODUCTS (через коллекцию)
================================ */

const related =
  collectionRel
    ? allProducts.filter((p) => {
        if (p.slug === product.slug) return false;

        const rels = p.data.relations ?? [];

        return rels.some(
          (r) =>
            r.type === "part_of" &&
            r.target === "collection" &&
            r.slug === collectionRel.slug
        );
      })
    : [];

/* ================================
   SEO
================================ */

const pageSEO = {
  title: product.data.title,
  description: product.data.title,
};
---

<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>

  <section class="section">
    <div class="container flow">

      {/* ================================
          MAIN
      ================================= */}

      <section class="product">

        {/* IMAGE */}
        <div class="product__image">
          <img
            src={product.data.image}
            alt={product.data.title}
          />
        </div>

        {/* INFO */}
        <div class="product__info flow">

          <h1>{product.data.title}</h1>

          {/* 👤 ARTIST */}
          {artist && (
            <div class="artist">
              by{" "}
              <a href={`/artists/${artist.slug}`}>
                {artist.data.title}
              </a>
            </div>
          )}

          {/* 💰 PRICE */}
          {product.data.price && (
            <div class="price">
              {product.data.price.amount} {product.data.price.currency}
            </div>
          )}

          {/* 🧾 META */}
          <div class="meta">
            {product.data.medium && <div>{product.data.medium}</div>}
            {product.data.size && <div>{product.data.size}</div>}
          </div>

          {/* CTA */}
          <div class="cta">
            <button class="buy">
              Buy this piece
            </button>
          </div>

          {/* DESCRIPTION */}
          <div class="description">
            <Content />
          </div>

          {/* ================================
              RELATIONS BLOCK (🔥 ключевой)
          ================================= */}

          <div class="relations flow">

            {/* 🔴 FROM */}
            {fromSketchbook && (
              <div class="relation relation--from">
                <div class="label">from</div>

                <a href={`/sketchbooks/${fromSketchbook.slug}`}>
                  {fromSketchbook.data.title}
                </a>

                {from?.page && (
                  <div class="page">
                    page {from.page}
                  </div>
                )}
              </div>
            )}

            {/* 🔵 COLLECTION */}
            {collection && (
              <div class="relation relation--collection">
                <div class="label">part of</div>

                <a href={`/collections/${collection.slug}`}>
                  {collection.data.title}
                </a>
              </div>
            )}

            {/* 🟡 RELATED */}
            {relatedRels.length > 0 && (
              <div class="relation relation--related">
                <div class="label">related</div>

                <div class="related-links">
                  {relatedRels.map((r) => {
                    if (r.target === "sketchbook") {
                      const s = sketchbooks.find((x) => x.slug === r.slug);
                      if (!s) return null;

                      return (
                        <a href={`/sketchbooks/${s.slug}`}>
                          {s.data.title}
                        </a>
                      );
                    }

                    if (r.target === "collection") {
                      const c = collections.find((x) => x.slug === r.slug);
                      if (!c) return null;

                      return (
                        <a href={`/collections/${c.slug}`}>
                          {c.data.title}
                        </a>
                      );
                    }

                    return null;
                  })}
                </div>
              </div>
            )}

          </div>

        </div>

      </section>

      {/* ================================
          RELATED PRODUCTS
      ================================= */}

      {related.length > 0 && (
        <section class="related">

          <h2>More from this series</h2>

          <div class="grid">
            {related.map((p) => (
              <a href={`/items/${p.slug}`} class="card">
                <div class="image">
                  <img src={p.data.image} alt={p.data.title} />
                </div>

                <div class="meta">
                  <div class="title">{p.data.title}</div>
                </div>
              </a>
            ))}
          </div>

        </section>
      )}

    </div>
  </section>

</InternalLayout>

<style>
.product {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.product__image img {
  width: 100%;
  border-radius: 12px;
}

.product__info {
  max-width: 420px;
}

.artist {
  font-size: 14px;
  opacity: 0.7;
  margin-top: -6px;
}

.price {
  font-size: 24px;
  font-weight: 600;
}

.meta {
  font-size: 14px;
  opacity: 0.7;
}

.buy {
  padding: 12px 20px;
  border-radius: 999px;
  border: none;
  background: black;
  color: white;
  cursor: pointer;
}

.description {
  font-size: 14px;
  line-height: 1.6;
}

/* ================================
   RELATIONS
================================ */

.relations {
  margin-top: 12px;
  font-size: 14px;
}

.relation .label {
  opacity: 0.5;
  font-size: 12px;
}

.relation--from {
  font-weight: 500;
}

.related-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.page {
  opacity: 0.6;
}

/* ================================
   RELATED GRID
================================ */

.related {
  margin-top: 48px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 16px;
}

.card {
  text-decoration: none;
  color: inherit;
}

.image {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 10px;
}

.image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.title {
  font-size: 13px;
  margin-top: 6px;
}
</style>