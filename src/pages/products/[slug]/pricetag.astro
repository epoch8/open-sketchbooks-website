---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

/* 👇 artist */
const artists = await getCollection("artists");

const artist = product.data.artist
  ? artists.find((a) => a.slug === product.data.artist)
  : null;

/* 👇 payment links */
const paymentLinks = artist?.data.paymentLinks ?? [];

/* 👇 ссылки */
const artistUrl = artist
  ? `https://open-sketchbook.place/artists/${artist.slug}`
  : null;
---

<html>
  <head>
    <meta charset="utf-8" />
    <title>{product.data.title} – Pricetag</title>

    <style>
      @page {
        size: A6;
        margin: 0;
      }

      body {
        margin: 0;
        font-family: system-ui;
      }

      .sheet {
        width: 105mm;
        height: 148mm;
        padding: 10mm;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        box-sizing: border-box;
      }

      /* ================================
         HEADER
      ================================= */

      .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
      }

      .header-text {
        flex: 1;
      }

      .title {
        font-size: 18px;
        font-weight: 600;
        line-height: 1.2;
      }

      .artist {
        font-size: 14px;
        opacity: 0.7;
        margin-top: 4px;
      }

      .artist-qr {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
      }

      /* ================================
         PRICE
      ================================= */

      .price {
        font-size: 28px;
        font-weight: 700;
        margin-top: 12px;
      }

      /* ================================
         PAYMENT TITLE
      ================================= */

      .payments-title {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        opacity: 0.5;
        margin-bottom: 8px;
      }

      /* ================================
         PAYMENTS
      ================================= */

      .payments-wrapper {
        margin-top: 12px;
      }

      .payments {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .payment {
        text-align: center;
      }

      .qr {
        width: 100%;
        aspect-ratio: 1 / 1;
      }

      .label {
        font-size: 11px;
        margin-top: 6px;
        opacity: 0.7;
      }

      /* ================================
         FOOTER
      ================================= */

      .footer {
        display: flex;
        justify-content: flex-start;
        margin-top: 12px;
      }

      .footer-text {
        font-size: 10px;
        opacity: 0.5;
      }

      /* ================================
         SCREEN PREVIEW
      ================================= */

      @media screen {
        body {
          background: #eee;
          display: flex;
          justify-content: center;
        }

        .sheet {
          background: white;
          margin: 40px 0;
        }
      }
    </style>
  </head>

  <body>
    <div class="sheet">

      {/* HEADER */}
      <div>

        <div class="header">

          <div class="header-text">
            <div class="title">
              {product.data.title}
            </div>

            {artist && (
              <div class="artist">
                by {artist.data.title}
              </div>
            )}
          </div>

          {artistUrl && (
            <img
              class="artist-qr"
              src={`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(artistUrl)}`}
            />
          )}

        </div>

        {product.data.price && (
          <div class="price">
            {product.data.price} {product.data.currency}
          </div>
        )}

      </div>

      {/* PAYMENTS */}
      {paymentLinks.length > 0 && (
        <div class="payments-wrapper">

          <div class="payments-title">
            Payment
          </div>

          <div class="payments">

            {paymentLinks.map((link) => (
              <div class="payment">

                <img
                  class="qr"
                  src={`https://api.qrserver.com/v1/create-qr-code/?size=600x600&data=${encodeURIComponent(link.url)}`}
                />

                <div class="label">
                  {link.title}
                </div>

              </div>
            ))}

          </div>

        </div>
      )}

      {/* FOOTER */}
      <div class="footer">
        <div class="footer-text">
          open-sketchbook.place
        </div>
      </div>

    </div>
  </body>
</html>