---
import InternalLayout from "@/layouts/InternalLayout.astro";
import { getCollection } from "astro:content";

import {
  mainNav,
  footerNav,
  footerMeta,
} from "@/content/template/navigation/navigation";

import BrandLogo from "@/components/products/open-sketchbooks/logo/BrandLogo.astro";
import { SEOBase } from "@/content/template/seo/seo";

/* ================================
   DATA
================================ */

const collections = await getCollection("productCollections");

/* 👇 можно потом сортировать иначе */
collections.sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

/* ================================
   SEO
================================ */

const pageSEO = {
  title: "Collections",
  description: "Art print collections",
};
---

<InternalLayout
  baseSEO={SEOBase}
  pageSEO={pageSEO}
  navItems={mainNav}
  footerSections={footerNav}
  footerMeta={footerMeta}
  logo={BrandLogo}
>

  <section class="section">
    <div class="container flow">

      {/* HEADER */}
      <header class="header flow">
        <h1>Collections</h1>
        <p class="subtitle">
          Series of prints extracted from sketchbooks
        </p>
      </header>

      {/* GRID */}
      <section class="grid">

        {collections.map((collection) => (
          <a
            href={`/collections/${collection.slug}`}
            class="card"
          >
            {/* COVER */}
            <div class="image">
              {collection.data.cover ? (
                <img
                  src={collection.data.cover}
                  alt={collection.data.title}
                />
              ) : (
                <div class="placeholder" />
              )}
            </div>

            {/* META */}
            <div class="meta">
              <div class="title">
                {collection.data.title}
              </div>

              {collection.data.description && (
                <div class="description">
                  {collection.data.description}
                </div>
              )}
            </div>
          </a>
        ))}

      </section>

    </div>
  </section>

</InternalLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 32px;
  }

  .card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f5f5f5;
  }

  .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    background: #eee;
  }

  .meta {
    margin-top: 12px;
  }

  .title {
    font-size: 16px;
    font-weight: 600;
  }

  .description {
    margin-top: 6px;
    font-size: 14px;
    color: rgba(0,0,0,0.6);
  }

  .subtitle {
    color: rgba(0,0,0,0.6);
    font-size: 14px;
  }
</style>