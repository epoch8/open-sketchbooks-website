---
import "@/styles/global.css";

import { extendSEO } from "@/lib/seo/extend";
import type { SEOConfig } from "@/lib/seo/types";

import Nav from "@/components/blocks/header/Nav.astro";
import Footer from "@/components/blocks/footer/Footer.astro";

import {
  buildMainNavSchema,
  buildFooterNavSchema,
} from "@/lib/seo/navigationSchema";

import GithubIcon from "@/components/icons/GithubIcon.astro";
import type { NavItem, IconName } from "@/lib/navigation/types";

/* ================================
   TYPES
================================ */

type NavSection = {
  title: string;
  items: NavItem[];
  enabled?: boolean;
};

type FooterMeta = {
  tagline?: string;
  company?: string;
};

interface Props {
  baseSEO: SEOConfig;
  pageSEO?: Partial<SEOConfig>;
  structuredData?: object | object[];
  lang?: string;

  showNav?: boolean;
  showFooter?: boolean;

  logo?: any;

  navItems?: NavItem[];
  footerSections?: NavSection[];
  footerMeta?: FooterMeta;

  icons?: Partial<Record<IconName, any>>;
}

/* ================================
   PROPS
================================ */

const {
  baseSEO,
  pageSEO,
  structuredData,
  lang = "en",

  showNav = true,
  showFooter = true,

  logo,

  navItems = [],
  footerSections = [],
  footerMeta = {},

  icons = {
    github: GithubIcon,
  },
} = Astro.props as Props;

const currentPath = Astro.url.pathname;

/* ================================
   SEO MERGE
================================ */

const seo: SEOConfig = pageSEO
  ? extendSEO(baseSEO, pageSEO)
  : baseSEO;

const {
  title,
  description,
  canonical,
  noindex,
  og,
  twitter,
  siteUrl,
} = seo;

/* ================================
   URL RESOLUTION (🔥 КЛЮЧЕВОЕ)
================================ */

const resolveUrl = (url?: string) => {
  if (!url) return undefined;
  if (url.startsWith("http")) return url;
  if (!siteUrl) return url;
  return `${siteUrl}${url}`;
};

const ogImage = resolveUrl(og?.image);
const twitterImage = resolveUrl(twitter?.image ?? og?.image);

/* ================================
   BASE URL (for schemas)
================================ */

const baseUrl =
  (canonical && new URL(canonical).origin) ||
  siteUrl ||
  "";

/* ================================
   STRUCTURED DATA
================================ */

const navigationSchemas = [
  buildMainNavSchema(baseUrl, navItems),
  buildFooterNavSchema(baseUrl, footerSections),
];

const allStructuredData = [
  ...navigationSchemas,
  ...(structuredData
    ? Array.isArray(structuredData)
      ? structuredData
      : [structuredData]
    : []),
];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>

    <!-- analytics -->
    <script is:inline>
      const allowedHosts = [
        "open-sketchbook.place",
        "www.open-sketchbook.place"
      ];

      if (allowedHosts.includes(window.location.hostname)) {
        const script = document.createElement("script");
        script.src = "https://www.googletagmanager.com/gtag/js?id=G-YD4RSLKX8T";
        script.async = true;

        script.onload = () => {
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          window.gtag = gtag;

          gtag('js', new Date());
          gtag('config', 'G-YD4RSLKX8T');
        };

        document.head.appendChild(script);
      }
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    {/* =========================
        OPEN GRAPH
    ========================= */}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={og?.type ?? "website"} />

    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {og?.imageAlt && (
      <meta property="og:image:alt" content={og.imageAlt} />
    )}

    {/* =========================
        TWITTER
    ========================= */}

    <meta
      name="twitter:card"
      content={twitter?.card ?? "summary_large_image"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {twitterImage && (
      <meta name="twitter:image" content={twitterImage} />
    )}

    {/* =========================
        STRUCTURED DATA
    ========================= */}

    {allStructuredData.map((item) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(item)}
      />
    ))}

    <slot name="head" />
  </head>

  <body class="page-root">
    {showNav && navItems.length > 0 && (
      <Nav
        items={navItems}
        currentPath={currentPath}
        logo={logo}
        icons={icons}
      />
    )}

    <main class="page-main">
      <slot />
    </main>

    <slot name="overlay" />

    {showFooter && footerSections.length > 0 && (
      <Footer
        sections={footerSections}
        meta={footerMeta}
        logo={logo}
      />
    )}
  </body>
</html>