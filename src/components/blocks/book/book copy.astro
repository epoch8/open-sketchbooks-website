---
interface Props {
  cover?: string;
  title?: string;
  pagesCount?: number;
  aspectRatio?: number; // width / height
}

const {
  cover = "https://via.placeholder.com/200x300",
  title = "",
  pagesCount = 100,
  aspectRatio: rawAspect,
} = Astro.props;


/* =========================
   ASPECT RATIO (SAFE)
========================= */

// 🔥 защита от мусора
const DEFAULT_ASPECT = 0.707; // A4 portrait

const aspectRatio =
  rawAspect && rawAspect > 0
    ? rawAspect
    : DEFAULT_ASPECT;


/* =========================
   NORMALIZED SIZE
========================= */

const MAX_W = 148;
const MAX_H = 210;

let width, height;

if (aspectRatio >= 1) {
  // landscape
  width = MAX_W;
  height = MAX_W / aspectRatio;
} else {
  // portrait
  height = MAX_H;
  width = MAX_H * aspectRatio;
}


/* =========================
   THICKNESS (ADAPTIVE)
========================= */

const baseThickness = pagesCount * 0.35;

const thickness = Math.min(
  Math.max(16, baseThickness),
  Math.min(width, height) * 0.22
);


/* =========================
   ORIENTATION
========================= */

const isLandscape = aspectRatio >= 1;

// 🔥 чуть разные углы
const rotateY = isLandscape ? -28 : -42;
const rotateX = isLandscape ? 1 : 2;
---

<div
  class="book"
  style={`
    --w: ${width}px;
    --h: ${height}px;
  `}
>
  <div
    class="book__wrapper"
    style={`
      --thickness: ${thickness}px;
      --rotateY: ${rotateY}deg;
      --rotateX: ${rotateX}deg;
    `}
  >
    <img
      class="book__cover"
      src={cover}
      alt={title}
      loading="lazy"
    />
  </div>
</div>

<style>

/* =========================
   BASE
========================= */

.book {
  display: flex;
  align-items: center;
  justify-content: center;

  width: var(--w);
  height: var(--h);

  perspective: 1200px; /* чуть глубже, но мягче эффект */
}


/* =========================
   WRAPPER
========================= */

.book__wrapper {
  position: relative;

  width: var(--w);
  height: var(--h);

  transform-style: preserve-3d;

  /* 🔥 ближе к зрителю */
  transform:
    rotateY(calc(var(--rotateY) + 22deg))
    rotateX(var(--rotateX));

  transition: transform 0.35s ease;
}


/* =========================
   COVER
========================= */

.book__cover {
  position: absolute;

  width: var(--w);
  height: var(--h);

  object-fit: cover;

  border-top-right-radius: 4px;
  border-bottom-right-radius: 4px;

  /* 🔥 аккуратная тень */
  box-shadow:
    4px 6px 18px rgba(0,0,0,0.18),
    inset -1px 0 3px rgba(0,0,0,0.12);
}


/* =========================
   PAGES
========================= */

.book__wrapper::before {
  content: "";

  position: absolute;
  top: 3px;

  height: calc(var(--h) - 6px);
  width: var(--thickness);

  background: linear-gradient(
    to right,
    #ffffff,
    #f5f5f5 50%,
    #eaeaea
  );

  transform:
    translateX(calc(var(--w) - var(--thickness) / 2 - 3px))
    rotateY(90deg)
    translateX(calc(var(--thickness) / 2));

  /* 🔥 почти незаметное разделение */
  box-shadow:
    inset 0 0 1px rgba(0,0,0,0.12);
}


/* =========================
   BACK COVER
========================= */

.book__wrapper::after {
  content: "";

  position: absolute;
  left: 0;

  width: var(--w);
  height: var(--h);

  border-top-right-radius: 4px;
  border-bottom-right-radius: 4px;

  background: linear-gradient(
    to right,
    #121212,
    #1c1c1c
  );

  transform: translateZ(calc(-1 * var(--thickness)));

  /* 🔥 сильно уменьшили */
  box-shadow:
    -8px 0 25px rgba(0,0,0,0.25);
}


/* =========================
   HOVER
========================= */

.book:hover .book__wrapper {
  transform:
    rotateY(calc(var(--rotateY) + 18deg)) /* было +10 → стало мягче относительно новой базы */
    rotateX(calc(var(--rotateX) + 1deg))
    scale(1.015); /* почти без зума */
}

</style>