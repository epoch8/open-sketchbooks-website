---
interface Props {
  cover?: string;
  title?: string;
  pagesCount?: number;

  width?: number;
  height?: number;

  scale?: number;
  tilt?: number; // 0..1

  shadow?: number; // 🔥 0..1
}

const {
  cover = "https://via.placeholder.com/200x300",
  title = "",
  pagesCount = 100,

  width: rawW,
  height: rawH,

  scale = 1,
  tilt: rawTilt,
  shadow: rawShadow,
} = Astro.props;


/* =========================
   SIZE
========================= */

const DEFAULT_W = 148;
const DEFAULT_H = 210;

const width = rawW && rawW > 0 ? rawW : DEFAULT_W;
const height = rawH && rawH > 0 ? rawH : DEFAULT_H;

const aspectRatio = width / height;


/* =========================
   THICKNESS
========================= */

const baseThickness = pagesCount * 0.35;

const thickness = Math.min(
  Math.max(14, baseThickness),
  Math.min(width, height) * 0.22
);


/* =========================
   ORIENTATION
========================= */

const isLandscape = aspectRatio >= 1;


/* =========================
   TILT
========================= */

const tilt = Math.min(Math.max(rawTilt ?? 1, 0), 1);

const maxTilt = isLandscape ? -28 : -42;
const rotateY = tilt * maxTilt;

const rotateX = isLandscape ? 1 : 2;


/* =========================
   SHADOW
========================= */

const shadow = Math.min(Math.max(rawShadow ?? 1, 0), 1);
---

<div
  class="book"
  style={`
    --w: ${width}px;
    --h: ${height}px;
    --scale: ${scale};
    --shadow: ${shadow};
  `}
>
  <div
    class="book__wrapper"
    style={`
      --thickness: ${thickness}px;
      --rotateY: ${rotateY}deg;
      --rotateX: ${rotateX}deg;
    `}
  >
    <img
      class="book__cover"
      src={cover}
      alt={title}
      loading="lazy"
    />
  </div>
</div>

<style>

/* =========================
   BASE
========================= */

.book {
  display: flex;
  align-items: center;
  justify-content: center;

  width: calc(var(--w) * var(--scale));
  height: calc(var(--h) * var(--scale));

  perspective: 1200px;
}


/* =========================
   WRAPPER
========================= */

.book__wrapper {
  position: relative;

  width: var(--w);
  height: var(--h);

  transform-style: preserve-3d;

  transform:
    scale(var(--scale))
    rotateY(var(--rotateY))
    rotateX(var(--rotateX));

  transition: transform 0.35s ease;
}


/* =========================
   COVER
========================= */

.book__cover {
  position: absolute;

  width: var(--w);
  height: var(--h);

  object-fit: cover;

  border-top-right-radius: 4px;
  border-bottom-right-radius: 4px;

  box-shadow:
    calc(4px * var(--shadow))
    calc(6px * var(--shadow))
    calc(18px * var(--shadow))
    rgba(0,0,0,0.18),

    inset
    calc(-1px * var(--shadow))
    0
    calc(3px * var(--shadow))
    rgba(0,0,0,0.12);
}


/* =========================
   PAGES
========================= */

.book__wrapper::before {
  content: "";

  position: absolute;
  top: 3px;

  height: calc(var(--h) - 6px);
  width: var(--thickness);

  background: linear-gradient(
    to right,
    #ffffff,
    #f5f5f5 50%,
    #eaeaea
  );

  transform:
    translateX(calc(var(--w) - var(--thickness) / 2 - 3px))
    rotateY(90deg)
    translateX(calc(var(--thickness) / 2));

  box-shadow:
    inset 0 0 calc(1px * var(--shadow)) rgba(0,0,0,0.12);
}


/* =========================
   BACK COVER
========================= */

.book__wrapper::after {
  content: "";

  position: absolute;
  left: 0;

  width: var(--w);
  height: var(--h);

  border-top-right-radius: 4px;
  border-bottom-right-radius: 4px;

  background: linear-gradient(
    to right,
    #121212,
    #1c1c1c
  );

  transform: translateZ(calc(-1 * var(--thickness)));

  box-shadow:
    calc(-8px * var(--shadow))
    0
    calc(25px * var(--shadow))
    rgba(0,0,0,0.25);
}


/* =========================
   HOVER
========================= */

.book:hover .book__wrapper {
  transform:
    scale(var(--scale))
    rotateY(calc(var(--rotateY) + 6deg))
    rotateX(calc(var(--rotateX) + 1deg));
}

</style>